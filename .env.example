# ─────────────────────────────────────────────────────────────────────────
# MAGIX — variabili d'ambiente per l'area riservata (backend Vercel Functions)
# Copia questo file in `.env.local` per lo sviluppo locale (`vercel dev`)
# e imposta gli stessi valori in Vercel → Project → Settings → Environment Variables.
# NON committare `.env.local` (è già in .gitignore).
# Finché ADMIN_USERNAME, ADMIN_PASSWORD e AUTH_SECRET non sono impostati,
# l'area riservata resta CHIUSA (nessun login possibile).
# ─────────────────────────────────────────────────────────────────────────

# Account dell'area riservata (/admin): username oppure email (non distingue maiuscole).
ADMIN_USERNAME=

# Password dell'account. Due formati accettati:
#  • in chiaro (scegline una robusta, es. 16+ caratteri);
#  • (consigliato) hash scrypt, così la password non è leggibile nelle env. Generalo con:
#      node -e "const c=require('crypto'),s=c.randomBytes(16);console.log('scrypt:'+s.toString('hex')+':'+c.scryptSync(process.argv[1],s,64).toString('hex'))" "LA-TUA-PASSWORD"
#    e incolla qui l'output (scrypt:…:…).
# Cambiare password (o username) chiude subito tutte le sessioni aperte.
ADMIN_PASSWORD=

# Segreto per firmare il cookie di sessione (HMAC), almeno 32 caratteri.
# Genera un valore casuale lungo, es:  openssl rand -hex 32
# Cambiarlo chiude tutte le sessioni aperte.
AUTH_SECRET=

# Token del Vercel Blob store (Storage → Blob → connetti al progetto).
# In locale viene popolato automaticamente da `vercel env pull .env.local`.
# Serve anche al login: le sessioni sono registrate sul Blob.
BLOB_READ_WRITE_TOKEN=

# (OPZIONALE) Chiave OpenRouteService (openrouteservice.org) per il tool
# "Trasferte & trasporti": geocoding/autocomplete indirizzi + distanza su strada.
# Se la lasci VUOTA, il tool funziona comunque usando OpenStreetMap Nominatim
# (indirizzi) + OSRM (percorso), che non richiedono chiave. Imposta questa chiave
# solo se vuoi qualità/affidabilità migliori o per evitare i limiti dei server OSM.
ORS_API_KEY=
